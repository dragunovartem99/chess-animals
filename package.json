{
	"name": "chess-animals",
	"private": true,
	"description": "Every animal plays chess its own strange way. Can you beat one?",
	"homepage": "https://github.com/dragunovartem99/chess-animals#readme",
	"bugs": {
		"url": "https://github.com/dragunovartem99/chess-animals/issues",
		"email": "dragunovartem99@gmail.com"
	},
	"author": {
		"name": "Artem Dragunov",
		"email": "dragunovartem99@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dragunovartem99/chess-animals.git"
	},
	"type": "module",
	"scripts": {
		"arena": "tsx cli/arena.ts",
		"bench": "vitest bench --run",
		"build": "tsx cli/og.ts && vue-tsc -b --noEmit && vite build",
		"dev": "vite",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"lint": "oxlint --fix",
		"lint:check": "oxlint",
		"og": "tsx cli/og.ts",
		"prepare": "husky",
		"preview": "vite preview",
		"test": "vitest",
		"test:coverage": "COVERAGE=1 vitest run --coverage",
		"tune": "tsx cli/tune.ts",
		"types:check": "vue-tsc -b --noEmit"
	},
	"dependencies": {
		"chessground": "^9.2.1",
		"chessops": "^0.15.1",
		"vue": "^3.5.39",
		"vue-i18n": "^11.1.14",
		"vue-router": "^4.5.1"
	},
	"devDependencies": {
		"@dragunovartem99/oxfmt-config": "^2.1.0",
		"@dragunovartem99/oxlint-config": "^2.0.0",
		"@fontsource/baloo-2": "^5.3.0",
		"@fontsource/fredoka": "^5.3.0",
		"@resvg/resvg-js": "^2.6.2",
		"@types/node": "^26.1.1",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vitest/coverage-v8": "^4.1.10",
		"@vue/tsconfig": "^0.9.1",
		"husky": "^9.1.7",
		"satori": "^0.33.4",
		"sharp": "^0.35.4",
		"tsx": "^4.23.13",
		"typescript": "~5.9.3",
		"vite": "^7.1.5",
		"vitest": "^4.1.10",
		"vue-tsc": "^3.3.7"
	},
	"engines": {
		"node": ">=24"
	}
}
