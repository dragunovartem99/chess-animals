{
	"extends": "@vue/tsconfig/tsconfig.dom.json",
	"include": ["env.d.ts", "src/**/*", "vite.config.ts", "vitest.config.ts"],
	"compilerOptions": {
		"types": ["node", "vite/client"],
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"noEmit": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
